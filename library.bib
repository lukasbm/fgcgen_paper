@article{kayaDeepMetricLearning2019,
  title = {Deep {{Metric Learning}}: {{A Survey}}},
  shorttitle = {Deep {{Metric Learning}}},
  author = {{Kaya} and {Bilge}},
  date = {2019-08-21},
