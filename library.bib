@article{weinbauerPrimeImplicantExplanations2025,
  title = {Prime {{Implicant Explanations}} for {{Reaction Feasibility Prediction}}},
  author = {Weinbauer, Klaus and Phan, Tieu-Long and Stadler, Peter F and Gärtner, Thomas and Malhotra, Sagar},
