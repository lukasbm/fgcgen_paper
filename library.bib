  author = {Freeman, Jeremy and Simoncelli, Eero P.},
  date = {2011-08-14},
  journaltitle = {Nature neuroscience},
  shortjournal = {Nat. Neurosci.},
  volume = {14},
  number = {9},
  eprint = {21841776},
  eprinttype = {pubmed},
  pages = {1195--1201},
