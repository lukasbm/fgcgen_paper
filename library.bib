@article{wellerStructureBasedDrugDesign2024,
  title = {Structure-{{Based Drug Design}} with a {{Deep Hierarchical Generative Model}}},
  author = {Weller, Jesse A. and Rohs, Remo},
  date = {2024-08-26},
  journaltitle = {Journal of Chemical Information and Modeling},
