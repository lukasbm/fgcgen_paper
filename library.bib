@online{rombachNetworktoNetworkTranslationConditional2020,
  title = {Network-to-{{Network Translation}} with {{Conditional Invertible Neural Networks}}},
  author = {Rombach, Robin and Esser, Patrick and Ommer, Björn},
  date = {2020-11-09},
  eprint = {2005.13580},
  eprinttype = {arXiv},
  eprintclass = {cs},
  doi = {10.48550/arXiv.2005.13580},
  url = {http://arxiv.org/abs/2005.13580},
  urldate = {2024-01-31},
  abstract = {Given the ever-increasing computational costs of modern machine learning models, we need to find new ways to reuse such expert models and thus tap into the resources that have been invested in their creation. Recent work suggests that the power of these massive models is captured by the representations they learn. Therefore, we seek a model that can relate between different existing representations and propose to solve this task with a conditionally invertible network. This network demonstrates its capability by (i) providing generic transfer between diverse domains, (ii) enabling controlled content synthesis by allowing modification in other domains, and (iii) facilitating diagnosis of existing representations by translating them into interpretable domains such as images. Our domain transfer network can translate between fixed representations without having to learn or finetune them. This allows users to utilize various existing domain-specific expert models from the literature that had been trained with extensive computational resources. Experiments on diverse conditional image synthesis tasks, competitive image modification results and experiments on image-to-image and text-to-image generation demonstrate the generic applicability of our approach. For example, we translate between BERT and BigGAN, state-of-the-art text and image models to provide text-to-image generation, which neither of both experts can perform on their own.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,Computer Science - Machine Learning,explainability},
  file = {/homes/biertank/lukas/Zotero/storage/2D42ULY9/Rombach et al. - 2020 - Network-to-Network Translation with Conditional In.pdf}
}

@online{ronenVisionTransformersMixedResolution2023,
  title = {Vision {{Transformers}} with {{Mixed-Resolution Tokenization}}},
  author = {Ronen, Tomer and Levy, Omer and Golbert, Avram},
  date = {2023-04-27},
  eprint = {2304.00287},
  eprinttype = {arXiv},
  eprintclass = {cs},
  doi = {10.1109/cvprw59228.2023.00486},
  url = {http://arxiv.org/abs/2304.00287},
  urldate = {2023-06-03},
  abstract = {Vision Transformer models process input images by dividing them into a spatially regular grid of equal-size patches. Conversely, Transformers were originally introduced over natural language sequences, where each token represents a subword - a chunk of raw data of arbitrary size. In this work, we apply this approach to Vision Transformers by introducing a novel image tokenization scheme, replacing the standard uniform grid with a mixed-resolution sequence of tokens, where each token represents a patch of arbitrary size. Using the Quadtree algorithm and a novel saliency scorer, we construct a patch mosaic where low-saliency areas of the image are processed in low resolution, routing more of the model's capacity to important image regions. Using the same architecture as vanilla ViTs, our Quadformer models achieve substantial accuracy gains on image classification when controlling for the computational budget. Code and models are publicly available at https://github.com/TomerRonen34/mixed-resolution-vit .},
  pubstate = {prepublished},
  keywords = {Computer Science - Computer Vision and Pattern Recognition,explainability},
  file = {/homes/biertank/lukas/Zotero/storage/2LLHWYRL/Ronen et al. - 2023 - Vision Transformers with Mixed-Resolution Tokeniza.pdf;/homes/biertank/lukas/Zotero/storage/P8JAQ5FG/2304.html}
}

@online{rooijFastDynamicProgramming2018,
  title = {Fast {{Dynamic Programming}} on {{Graph Decompositions}}},
  author = {family=Rooij, given=Johan M. M., prefix=van, useprefix=false and Bodlaender, Hans L. and family=Leeuwen, given=Erik Jan, prefix=van, useprefix=false and Rossmanith, Peter and Vatshelle, Martin},
  date = {2018-06-05},
  eprint = {1806.01667},
  eprinttype = {arXiv},
  eprintclass = {cs.DS},
  doi = {10.48550/arXiv.1806.01667},
  url = {http://arxiv.org/abs/1806.01667},
  urldate = {2026-07-03},
  abstract = {In this paper, we consider tree decompositions, branch decompositions, and clique decompositions. We improve the running time of dynamic programming algorithms on these graph decompositions for a large number of problems as a function of the treewidth, branchwidth, or cliquewidth, respectively. On tree decompositions of width \$k\$, we improve the running time for Dominating Set to \$O(3\textasciicircum k)\$. We generalise this result to \$[ρ,σ]\$-domination problems with finite or cofinite \$ρ\$ and \$σ\$. For these problems, we give \$O(s\textasciicircum k)\$-time algorithms, where \$s\$ is the number of `states' a vertex can have in a standard dynamic programming algorithm for such a problems. Furthermore, we give an \$O(2\textasciicircum k)\$-time algorithm for counting the number of perfect matchings in a graph, and generalise this to \$O(2\textasciicircum k)\$-time algorithms for many clique covering, packing, and partitioning problems. On branch decompositions of width \$k\$, we give an \$O(3\textasciicircum\{\textbackslash fracω\{2\}k\})\$-time algorithm for Dominating Set, an \$O(2\textasciicircum\{\textbackslash fracω\{2\}k\})\$-time algorithm for counting the number of perfect matchings, and \$O(s\textasciicircum\{\textbackslash fracω\{2\}k\})\$-time algorithms for \$[ρ,σ]\$-domination problems involving \$s\$ states with finite or cofinite \$ρ\$ and \$σ\$. Finally, on clique decompositions of width \$k\$, we give \$O(4\textasciicircum k)\$-time algorithms for Dominating Set, Independent Dominating Set, and Total Dominating Set. The main techniques used in this paper are a generalisation of fast subset convolution, as introduced by Björklund et al., now applied in the setting of graph decompositions and augmented such that multiple states and multiple ranks can be used. Recently, Lokshtanov et al. have shown that some of the algorithms obtained in this paper have running times in which the base in the exponents is optimal, unless the Strong Exponential-Time Hypothesis fails.},
  pubstate = {prepublished},
  keywords = {Computer Science - Data Structures and Algorithms},
  file = {/homes/biertank/lukas/Zotero/storage/ZG6E3UW8/Rooij et al. - 2018 - Fast Dynamic Programming on Graph Decompositions.pdf}
}

@article{roseVisualPrototypesVentral2021,
  title = {Visual Prototypes in the Ventral Stream Are Attuned to Complexity and Gaze Behavior},
  author = {Rose, Olivia and Johnson, James and Wang, Binxu and Ponce, Carlos R.},
  date = {2021-11-18},
  journaltitle = {Nature Communications},
  shortjournal = {Nat. Commun.},
  volume = {12},
  number = {1},
  pages = {6723},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-021-27027-8},
  url = {https://www.nature.com/articles/s41467-021-27027-8},
  urldate = {2023-12-14},
  abstract = {Early theories of efficient coding suggested the visual system could compress the world by learning to represent features where information was concentrated, such as contours. This view was validated by the discovery that neurons in posterior visual cortex respond to edges and curvature. Still, it remains unclear what other information-rich features are encoded by neurons in more anterior cortical regions (e.g., inferotemporal cortex). Here, we use a generative deep neural network to synthesize images guided by neuronal responses from across the visuocortical hierarchy, using floating microelectrode arrays in areas V1, V4 and inferotemporal cortex of two macaque monkeys. We hypothesize these images (“prototypes”) represent such predicted information-rich features. Prototypes vary across areas, show moderate complexity, and resemble salient visual attributes and semantic content of natural images, as indicated by the animals’ gaze behavior. This suggests the code for object recognition represents compressed features of behavioral relevance, an underexplored aspect of efficient coding.},
  eid = {1},
  langid = {english},
  keywords = {Neural decoding},
  file = {/homes/biertank/lukas/Zotero/storage/WLFQCFE7/Rose et al. - 2021 - Visual prototypes in the ventral stream are attune.pdf}
}

@inproceedings{rossiStructuralGraphRepresentation2020,
  title = {A {{Structural Graph Representation Learning Framework}}},
  booktitle = {Proceedings of the 13th {{International Conference}} on {{Web Search}} and {{Data Mining}}},
  author = {Rossi, Ryan A. and Ahmed, Nesreen K. and Koh, Eunyee and Kim, Sungchul and Rao, Anup and Abbasi-Yadkori, Yasin},
  date = {2020-01-20},
  pages = {483--491},
  publisher = {ACM},
  location = {Houston TX USA},
  doi = {10.1145/3336191.3371843},
  url = {https://dl.acm.org/doi/10.1145/3336191.3371843},
  urldate = {2026-06-04},
  abstract = {The success of many graph-based machine learning tasks highly depends on an appropriate representation learned from the graph data. Most work has focused on learning node embeddings that preserve proximity as opposed to structural role-based embeddings that preserve the structural similarity among nodes. These methods fail to capture higher-order structural dependencies and connectivity patterns that are crucial for structural role-based applications such as visitor stitching from web logs. In this work, we formulate higher-order network representation learning and describe a general framework called HONE for learning such structural node embeddings from networks via the subgraph patterns (network motifs, graphlet orbits/positions) in a nodes neighborhood. A general diffusion mechanism is introduced in HONE along with a spaceefficient approach that avoids explicit construction of the k-step motif-based matrices using a k-step linear operator. Furthermore, HONE is shown to be fast and efficient with a worst-case time complexity that is nearly-linear in the number of edges. The experiments demonstrate the effectiveness of HONE for a number of important tasks including link prediction and visitor stitching from large web log data.},
  eventtitle = {{{WSDM}} '20: {{The Thirteenth ACM International Conference}} on {{Web Search}} and {{Data Mining}}},
  isbn = {978-1-4503-6822-3},
  langid = {english},
  file = {/homes/biertank/lukas/Zotero/storage/QMFZ6QDG/Rossi et al. - 2020 - A Structural Graph Representation Learning Framework.pdf}
}

