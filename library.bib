@article{fischerDecomposingNeuralNetworks2022,
  title = {Decomposing Neural Networks as Mappings of Correlation Functions},
  author = {Fischer, Kirsten and René, Alexandre and Keup, Christian and Layer, Moritz and Dahmen, David and Helias, Moritz},
  date = {2022-11-28},
  journaltitle = {Physical Review Research},
  shortjournal = {Phys. Rev. Res.},
  volume = {4},
  number = {4},
  eprint = {2202.04925},
