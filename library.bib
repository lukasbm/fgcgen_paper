@article{fangEvaluatingPosthocExplanations2023,
  title = {Evaluating {{Post}}-Hoc {{Explanations}} for {{Graph Neural Networks}} via {{Robustness Analysis}}},
  author = {Fang, Junfeng and Liu, Wei and Gao, Yuan and Liu, Zemin and Zhang, An and Wang, Xiang and He, Xiangnan},
  date = {2023},
  journaltitle = {Advances in Neural Information Processing Systems 36},
  shortjournal = {Adv. Neural Inf. Process. Syst. 36},
  doi = {10.52202/075280-3168},
  abstract = {This work studies the evaluation of explaining graph neural networks (GNNs), which is crucial to the credibility of post-hoc explainability in practical usage. Conventional evaluation metrics, and even explanation methods — which mainly follow the paradigm of feeding the explanatory subgraph to the model and measuring output difference — mostly suffer from the notorious out-of-distribution (OOD) issue. Hence, in this work, we endeavor to confront this issue by introducing a novel evaluation metric, termed OOD-resistant Adversarial Robustness (OAR). Specifically, we draw inspiration from adversarial robustness and evaluate post-hoc explanation subgraphs by calculating their robustness under attack. On top of that, an elaborate OOD reweighting block is inserted into the pipeline to confine the evaluation process to the original data distribution. For applications involving large datasets, we further devise a Simplified version of OAR (SimOAR), which achieves a significant improvement in computational efficiency at the cost of a small amount of performance. Extensive empirical studies validate the effectiveness of our OAR and SimOAR. Code is available at https://github.com/MangoKiller/SimOAR\_OAR.},
  langid = {english},
  keywords = {explainability,neurips,ood,robustness},
  file = {/homes/biertank/lukas/Zotero/storage/8ESVMWAT/Fang et al. - Evaluating Post-hoc Explanations for Graph Neural Networks via Robustness Analysis.pdf}
}

