@online{bartolomeisHowRobustAccuracy2023,
  title = {How Robust Accuracy Suffers from Certified Training with Convex Relaxations},
  author = {Bartolomeis, Piersilvio De and Clarysse, Jacob and Sanyal, Amartya and Yang, Fanny},
