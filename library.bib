  shorttitle = {Chemical Reaction Network Knowledge Graphs},
  author = {Garay-Ruiz, Diego and Bo, Carles},
  date = {2022-12},
  journaltitle = {Journal of Cheminformatics},
  shortjournal = {J. Cheminformatics},
  volume = {14},
  number = {1},
