@online{gengLogicXGNNGroundedLogical2026,
  title = {{{LogicXGNN}}: {{Grounded Logical Rules}} for {{Explaining Graph Neural Networks}}},
  shorttitle = {{{LogicXGNN}}},
  author = {Geng, Chuqin and Zhao, Ziyu and Wang, Zhaoyue and Ye, Haolin and Jiang, Yuhe and Si, Xujie},
  date = {2026-03-16},
  eprint = {2503.19476},
  eprinttype = {arXiv},
  eprintclass = {cs.LG},
  doi = {10.48550/arXiv.2503.19476},
  url = {http://arxiv.org/abs/2503.19476},
  urldate = {2026-09-08},
  abstract = {Existing rule-based explanations for Graph Neural Networks (GNNs) provide global interpretability but often optimize and assess fidelity in an intermediate, uninterpretable concept space, overlooking grounding quality for end users in the final subgraph explanations. This gap yields explanations that may appear faithful yet be unreliable in practice. To this end, we propose LogicXGNN, a post-hoc framework that constructs logical rules over reliable predicates explicitly designed to capture the GNN's message-passing structure, thereby ensuring effective grounding. We further introduce data-grounded fidelity (\$\textbackslash textit\{Fid\}\_\{\textbackslash mathcal\{D\}\}\$), a realistic metric that evaluates explanations in their final-graph form, along with complementary utility metrics such as coverage and validity. Across extensive experiments, LogicXGNN improves \$\textbackslash textit\{Fid\}\_\{\textbackslash mathcal\{D\}\}\$ by over 20\% on average relative to state-of-the-art methods while being 10-100 \$\textbackslash times\$ faster. With strong scalability and utility performance, LogicXGNN produces explanations that are faithful to the model's logic and reliably grounded in observable data. Our code is available at https://github.com/allengeng123/LogicXGNN/.},
  pubstate = {prepublished},
  keywords = {Computer Science - Machine Learning,explainability},
  file = {/homes/biertank/lukas/Zotero/storage/ZELETEPM/Geng et al. - 2026 - LogicXGNN Grounded Logical Rules for Explaining Graph Neural Networks.pdf}
}

@online{gengMessagePassingSymbolic2026,
  title = {Beyond {{Message Passing}}: {{A Symbolic Alternative}} for {{Expressive}} and {{Interpretable Graph Learning}}},
  shorttitle = {Beyond {{Message Passing}}},
  author = {Geng, Chuqin and Zhang, Li and Ye, Haolin and Zhao, Ziyu and Jiang, Yuhe and Saba, Tara and Wang, Xinyu and Si, Xujie},
  date = {2026-02-23},
  eprint = {2602.16947},
  eprinttype = {arXiv},
  eprintclass = {cs.LG},
  doi = {10.48550/arXiv.2602.16947},
  url = {http://arxiv.org/abs/2602.16947},
  urldate = {2026-06-13},
  abstract = {Graph Neural Networks (GNNs) have become essential in high-stakes domains such as drug discovery, yet their black-box nature remains a significant barrier to trustworthiness. While selfexplainable GNNs attempt to bridge this gap, they often rely on standard message-passing backbones that inherit fundamental limitations, including the 1-Weisfeiler-Lehman (1-WL) expressivity barrier and a lack of fine-grained interpretability. To address these challenges, we propose SYMGRAPH, a symbolic framework designed to transcend these constraints. By replacing continuous message passing with discrete structural hashing and topological role-based aggregation, our architecture theoretically surpasses the 1WL barrier, achieving superior expressiveness without the overhead of differentiable optimization. Extensive empirical evaluations demonstrate that SYMGRAPH achieves state-of-the-art performance, outperforming existing self-explainable GNNs. Notably, SYMGRAPH delivers 10× to 100× speedups in training time using only CPU execution. Furthermore, SYMGRAPH generates rules with superior semantic granularity compared to existing rule-based methods, offering great potential for scientific discovery and explainable AI.},
  pubstate = {prepublished},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning,explainability},
  file = {/homes/biertank/lukas/Zotero/storage/LZPXLM9V/Geng et al. - 2026 - Beyond Message Passing A Symbolic Alternative for Expressive and Interpretable Graph Learning.pdf}
}

@online{gengNeuralProposalsSymbolic2026,
  title = {Neural {{Proposals}}, {{Symbolic Guarantees}}: {{Neuro-Symbolic Graph Generation}} with {{Hard Constraints}}},
  shorttitle = {Neural {{Proposals}}, {{Symbolic Guarantees}}},
  author = {Geng, Chuqin and Zhang, Li and Zhang, Mark and Ye, Haolin and Zhao, Ziyu and Si, Xujie},
  date = {2026-02-24},
  eprint = {2602.16954},
  eprinttype = {arXiv},
  eprintclass = {cs},
  doi = {10.48550/arXiv.2602.16954},
  url = {http://arxiv.org/abs/2602.16954},
  urldate = {2026-03-12},
  abstract = {We challenge black-box purely deep neural approaches for molecules and graph generation, which are limited in controllability and lack formal guarantees. We introduce NeuroSymbolic Graph Generative Modeling (NSGGM), a neurosymbolic framework that reapproaches molecule generation as a scaffold and interaction learning task with symbolic assembly. An autoregressive neural model proposes scaffolds and refines interaction signals, and a CPU-efficient SMT solver constructs full graphs while enforcing chemical validity, structural rules, and userspecific constraints, yielding molecules that are correct by construction and interpretable control that pure neural methods cannot provide. NSGGM delivers strong performance on both unconstrained generation and constrained generation tasks, demonstrating that neuro-symbolic modeling can match state-of-the-art generative performance while offering explicit controllability and guarantees. To evaluate more nuanced controllability, we also introduce a LogicalConstraint Molecular Benchmark, designed to test strict hard-rule satisfaction in workflows that require explicit, interpretable specifications together with verifiable compliance.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {Computer Science - Machine Learning,explainability,FOS: Computer and information sciences,generation,Machine Learning (cs.LG)},
  file = {/homes/biertank/lukas/Zotero/storage/28PXV4Z8/Geng et al. - 2026 - Neural Proposals, Symbolic Guarantees Neuro-Symbolic Graph Generation with Hard Constraints.pdf}
}

