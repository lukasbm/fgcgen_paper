@article{groheDescriptiveComplexityGraph2024,
  title = {The {{Descriptive Complexity}} of {{Graph Neural Networks}}},
  author = {Grohe, Martin},
  date = {2024-12-04},
  journaltitle = {TheoretiCS},
  volume = {Volume 3},
  eprint = {2303.04613},
  eprinttype = {arXiv},
  eprintclass = {cs.LO},
  pages = {12238},
  issn = {2751-4838},
  doi = {10.46298/theoretics.24.25},
  url = {http://arxiv.org/abs/2303.04613},
  urldate = {2026-06-16},
  abstract = {We analyse the power of graph neural networks (GNNs) in terms of Boolean circuit complexity and descriptive complexity. We prove that the graph queries that can be computed by a polynomial-size bounded-depth family of GNNs are exactly those definable in the guarded fragment GFO+C of first-order logic with counting and with built-in relations. This puts GNNs in the circuit complexity class (non-uniform) \$\textbackslash text\{TC\}\textasciicircum 0\$. Remarkably, the GNN families may use arbitrary real weights and a wide class of activation functions that includes the standard ReLU, logistic "sigmoid", and hyperbolic tangent functions. If the GNNs are allowed to use random initialisation and global readout (both standard features of GNNs widely used in practice), they can compute exactly the same queries as bounded depth Boolean circuits with threshold gates, that is, exactly the queries in \$\textbackslash text\{TC\}\textasciicircum 0\$. Moreover, we show that queries computable by a single GNN with piecewise linear activations and rational weights are definable in GFO+C without built-in relations. Therefore, they are contained in uniform \$\textbackslash text\{TC\}\textasciicircum 0\$.},
  keywords = {Computer Science - Computational Complexity,Computer Science - Logic in Computer Science,Computer Science - Machine Learning},
  file = {/homes/biertank/lukas/Zotero/storage/VW2JXNLZ/Grohe - 2024 - The Descriptive Complexity of Graph Neural Networks.pdf;/homes/biertank/lukas/Zotero/storage/XK9N9R4T/2303.html}
}

